        <mxCell id="1xF1tfhiL65rfsUJ1hpM-15" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;免费开源&lt;span style=&quot;background-color: initial; font-size: 12px; font-weight: normal;&quot;&gt;.&lt;/span&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
